# Credenciais administrativas da conta Confluent: manter em Codespaces Secrets.
AIVEN_TOKEN=
# Nao preencher nem imprimir os valores neste arquivo.
CONFLUENT_CLOUD_API_KEY=
CONFLUENT_CLOUD_API_SECRET=

# Geradas pelo Terraform apos o primeiro apply e exportadas para .env local.
# Os nomes TF_VAR_foundation_* evitam colisao com credenciais antigas da V1.
TF_VAR_foundation_environment_id=
KAFKA_BOOTSTRAP_ENDPOINT=
TF_VAR_foundation_kafka_id=
TF_VAR_foundation_kafka_rest_endpoint=
TF_VAR_foundation_kafka_api_key=
TF_VAR_foundation_kafka_api_secret=
TF_VAR_foundation_schema_registry_id=
TF_VAR_foundation_schema_registry_rest_endpoint=
TF_VAR_foundation_schema_registry_api_key=
TF_VAR_foundation_schema_registry_api_secret=

# Credenciais de runtime para os clientes do desafio.
PRODUCER_KAFKA_API_KEY=
PRODUCER_KAFKA_API_SECRET=
CONSUMER_KAFKA_API_KEY=
CONSUMER_KAFKA_API_SECRET=

# O exporter habilita as ACLs somente depois de disponibilizar a chave admin.
TF_VAR_enable_kafka_acls=false
