+
+
+## Marco 4 — Foundation Confluent
+
+A Foundation declara, sem reutilizar IDs da V1:
+
+- Environment `desafio-final` com Stream Governance Essentials.
+- Kafka Basic `desafio-basic` em AWS `us-east-1`, zona unica.
+- Identidades `desafio-iac-admin`, `desafio-producer`, `desafio-consumer` e `desafio-schema-registry`.
+- API Keys de cluster para o administrador, producer e consumer; API Key do Schema Registry.
+- `CloudClusterAdmin` restrito ao CRN do cluster para a identidade técnica de IaC.
+- `DeveloperRead` e `DeveloperWrite` restritos aos subjects do Schema Registry.
+- ACLs de producer/consumer para o prefixo `desafio-`, inicialmente desabilitadas.
+
+O Kafka Basic não recebe RBAC granular por tópico/grupo; essas permissões são ACLs. O papel `CloudClusterAdmin` é aplicado somente no escopo do cluster para administrar ACLs, sem conceder `EnvironmentAdmin`. No Schema Registry, `DeveloperRead` e `DeveloperWrite` são separados; evitamos `ResourceOwner`, que concederia poderes de gestão de acesso e criação de identidades desnecessários para o contrato de schemas.
+
+### Sequência local
+
+```text
+python lab.py setup
+python lab.py test
+python lab.py plan
+```
+
+O primeiro plano deixa `enable_kafka_acls=false`, pois a API Key do `desafio-iac-admin` ainda não foi exportada para o provider. O plano é apenas leitura; não cria recursos. **Não executar apply até revisar o plano, confirmar o custo do cluster e concluir o mecanismo controlado de apply/teardown.**
+
+Depois que a Foundation for aplicada em uma janela autorizada, exporte os outputs sem imprimi-los:
+
+```text
+python scripts/export_foundation_env.py
+```
+
+O script grava os endpoints e credenciais em `.env` (ignorado pelo Git, modo de arquivo 0600), preserva os valores já existentes e habilita as ACLs para o segundo plano. Os secrets nunca são enviados ao stdout. O provider usa `TF_VAR_foundation_*` para não confundir credenciais V2 com variáveis `KAFKA_API_KEY` antigas da V1.
+
+O State Terraform local contém secrets de API Key. `sensitive=true` oculta valores na CLI, mas não cifra o State. Manter o Codespace e o State protegidos até o teardown confirmado; nunca versionar State ou plan.
diff --git a/infra/terraform/foundation.tf b/infra/terraform/foundation.tf
new file mode 100644
index 0000000..b4d76c2
--- /dev/null
+++ b/infra/terraform/foundation.tf
@@ -0,0 +1,172 @@
+# Marco 4 - Foundation do desafio DIO.
+# Os nomes e a regiao seguem o template de entrega do desafio.
+# Nenhum ID ou endpoint da V1 e reutilizado.
+
+resource "confluent_environment" "challenge" {
+  display_name = "desafio-final"
+
+  stream_governance {
+    package = "ESSENTIALS"
+  }
+}
+
+resource "confluent_kafka_cluster" "basic" {
+  display_name = "desafio-basic"
+  availability = "SINGLE_ZONE"
+  cloud        = "AWS"
+  region       = "us-east-1"
+
+  basic {}
+
+  environment {
+    id = confluent_environment.challenge.id
+  }
+}
+
+# O Schema Registry Essentials e associado ao Environment. A instanciacao
+# regional acontece com o primeiro cluster Kafka do Environment.
+data "confluent_schema_registry_cluster" "essentials" {
+  environment {
+    id = confluent_environment.challenge.id
+  }
+
+  depends_on = [confluent_kafka_cluster.basic]
+}
+
+# Identidade administrativa usada exclusivamente para administrar ACLs Kafka.
+# CloudClusterAdmin fica restrito ao cluster, sem conceder EnvironmentAdmin.
+resource "confluent_service_account" "iac_admin" {
+  display_name = "desafio-iac-admin"
+  description  = "Identidade tecnica para administrar ACLs do cluster do desafio"
+}
+
+resource "confluent_role_binding" "iac_admin_cluster_admin" {
+  principal   = "User:${confluent_service_account.iac_admin.id}"
+  role_name   = "CloudClusterAdmin"
+  crn_pattern = confluent_kafka_cluster.basic.rbac_crn
+}
+
+# Identidades de aplicacao separadas, conforme o contrato da entrega.
+resource "confluent_service_account" "producer" {
+  display_name = "desafio-producer"
+  description  = "Identidade de producer para topicos com prefixo desafio-"
+}
+
+resource "confluent_service_account" "consumer" {
+  display_name = "desafio-consumer"
+  description  = "Identidade de consumer para topicos e grupos com prefixo desafio-"
+}
+
+resource "confluent_service_account" "schema_registry" {
+  display_name = "desafio-schema-registry"
+  description  = "Identidade dedicada a publicacao e gestao dos schemas do desafio"
+}
+
+# A chave administrativa e de cluster (Kafka), nao Cloud API.
+# A identidade recebe CloudClusterAdmin antes da criacao da chave.
+resource "confluent_api_key" "iac_admin_kafka" {
+  display_name = "desafio-iac-admin-kafka"
+  description  = "Kafka API Key usada pelo Terraform para administrar ACLs"
+
+  owner {
+    id          = confluent_service_account.iac_admin.id
+    api_version = confluent_service_account.iac_admin.api_version
+    kind        = confluent_service_account.iac_admin.kind
+  }
+
+  managed_resource {
+    id          = confluent_kafka_cluster.basic.id
+    api_version = confluent_kafka_cluster.basic.api_version
+    kind        = confluent_kafka_cluster.basic.kind
+
+    environment {
+      id = confluent_environment.challenge.id
+    }
+  }
+
+  depends_on = [confluent_role_binding.iac_admin_cluster_admin]
+}
+
+resource "confluent_api_key" "producer_kafka" {
+  display_name = "desafio-producer-kafka"
+  description  = "Kafka API Key owned by desafio-producer"
+
+  owner {
+    id          = confluent_service_account.producer.id
+    api_version = confluent_service_account.producer.api_version
+    kind        = confluent_service_account.producer.kind
+  }
+
+  managed_resource {
+    id          = confluent_kafka_cluster.basic.id
+    api_version = confluent_kafka_cluster.basic.api_version
+    kind        = confluent_kafka_cluster.basic.kind
+
+    environment {
+      id = confluent_environment.challenge.id
+    }
+  }
+}
+
+resource "confluent_api_key" "consumer_kafka" {
+  display_name = "desafio-consumer-kafka"
+  description  = "Kafka API Key owned by desafio-consumer"
+
+  owner {
+    id          = confluent_service_account.consumer.id
+    api_version = confluent_service_account.consumer.api_version
+    kind        = confluent_service_account.consumer.kind
+  }
+
+  managed_resource {
+    id          = confluent_kafka_cluster.basic.id
+    api_version = confluent_kafka_cluster.basic.api_version
+    kind        = confluent_kafka_cluster.basic.kind
+
+    environment {
+      id = confluent_environment.challenge.id
+    }
+  }
+}
+
+# Schema Registry usa RBAC por subject, mesmo com Kafka Basic.
+# Read e Write sao separados para evitar ResourceOwner, que tambem permite
+# gerenciar permissoes e criar identidades. O desafio precisa registrar, ler
+# e validar schemas, nao administrar acessos ou excluir subjects.
+resource "confluent_role_binding" "schema_registry_subject_read" {
+  principal   = "User:${confluent_service_account.schema_registry.id}"
+  role_name   = "DeveloperRead"
+  crn_pattern = "${data.confluent_schema_registry_cluster.essentials.resource_name}/subject=*"
+}
+
+resource "confluent_role_binding" "schema_registry_subject_write" {
+  principal   = "User:${confluent_service_account.schema_registry.id}"
+  role_name   = "DeveloperWrite"
+  crn_pattern = "${data.confluent_schema_registry_cluster.essentials.resource_name}/subject=*"
+}
+
+resource "confluent_api_key" "schema_registry" {
+  display_name = "desafio-schema-registry"
+  description  = "Schema Registry API Key owned by desafio-schema-registry"
+
+  owner {
+    id          = confluent_service_account.schema_registry.id
+    api_version = confluent_service_account.schema_registry.api_version
+    kind        = confluent_service_account.schema_registry.kind
+  }
+
+  managed_resource {
+    id          = data.confluent_schema_registry_cluster.essentials.id
+    api_version = data.confluent_schema_registry_cluster.essentials.api_version
+    kind        = data.confluent_schema_registry_cluster.essentials.kind
+
+    environment {
+      id = confluent_environment.challenge.id
+    }
+  }
+
+  depends_on = [
+    confluent_role_binding.schema_registry_subject_read,
+    confluent_role_binding.schema_registry_subject_write,
+  ]
+}
diff --git a/infra/terraform/kafka-acls.tf b/infra/terraform/kafka-acls.tf
new file mode 100644
index 0000000..739497d
--- /dev/null
+++ b/infra/terraform/kafka-acls.tf
@@ -0,0 +1,41 @@
+# Kafka Basic utiliza ACLs para permissao em topicos e consumer groups.
+# A criacao fica desabilitada no primeiro apply: a API Key do iac_admin
+# precisa ser criada e exportada para KAFKA_API_KEY/KAFKA_API_SECRET antes.
+# O provider Confluent recebe KAFKA_ID, KAFKA_REST_ENDPOINT e credenciais
+# por variaveis de ambiente; nao colocar secrets em blocos credentials.
+
+resource "confluent_kafka_acl" "producer_topic_write" {
+  count = var.enable_kafka_acls ? 1 : 0
+
+  resource_type = "TOPIC"
+  resource_name = var.kafka_topic_prefix
+  pattern_type  = "PREFIXED"
+  principal     = "User:${confluent_service_account.producer.id}"
+  host          = "*"
+  operation     = "WRITE"
+  permission    = "ALLOW"
+}
+
+resource "confluent_kafka_acl" "consumer_topic_read" {
+  count = var.enable_kafka_acls ? 1 : 0
+
+  resource_type = "TOPIC"
+  resource_name = var.kafka_topic_prefix
+  pattern_type  = "PREFIXED"
+  principal     = "User:${confluent_service_account.consumer.id}"
+  host          = "*"
+  operation     = "READ"
+  permission    = "ALLOW"
+}
+
+resource "confluent_kafka_acl" "consumer_group_read" {
+  count = var.enable_kafka_acls ? 1 : 0
+
+  resource_type = "GROUP"
+  resource_name = var.kafka_topic_prefix
+  pattern_type  = "PREFIXED"
+  principal     = "User:${confluent_service_account.consumer.id}"
+  host          = "*"
+  operation     = "READ"
+  permission    = "ALLOW"
+}
